{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "theme": {
      "type": "string",
      "enum": ["console", "terminal", "openapi", "git", "status", "rpg"],
      "description": "The design: console (API explorer), terminal (CLI), openapi (Swagger spec), git (repository), status (status page), rpg (character sheet)."
    },
    "locales": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 5
      },
      "description": "Languages the site is built in; each needs messages/<locale>.json and content/<locale>/"
    },
    "defaultLocale": {
      "type": "string",
      "description": "Where / redirects when the visitor's language is not available"
    },
    "verification": {
      "description": "Search Console / Webmaster Tools HTML-tag tokens; rendered as <meta> on every page",
      "type": "object",
      "properties": {
        "google": {
          "type": "string"
        },
        "bing": {
          "type": "string"
        }
      }
    },
    "hero": {
      "type": "object",
      "properties": {
        "left": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "description": "File name shown above the column"
            },
            "lang": {
              "type": "string"
            },
            "lines": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": ["title", "lang", "lines"]
        },
        "right": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "description": "File name shown above the column"
            },
            "lang": {
              "type": "string"
            },
            "lines": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": ["title", "lang", "lines"]
        }
      },
      "required": ["left", "right"]
    },
    "easterEgg": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "Typing DELETE <path> in the request bar answers with the message"
        }
      },
      "required": ["path"]
    },
    "endpoints": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "enum": ["GET", "POST"]
          },
          "path": {
            "type": "string",
            "description": "As displayed, e.g. \"/skills?filter=\""
          },
          "href": {
            "type": "string",
            "description": "The page folder under app/[locale]/(explorer), e.g. /skills"
          },
          "indexable": {
            "type": "boolean",
            "description": "In the sitemap and llms.txt; false for form-like pages"
          }
        },
        "required": ["method", "path", "href", "indexable"]
      }
    }
  },
  "required": ["theme", "locales", "defaultLocale", "hero", "easterEgg", "endpoints"]
}
