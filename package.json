{
  "name": "mycv",
  "version": "1.0.0",
  "private": true,
  "description": "Your CV as a site: six designs, ten languages, one JSON file. Static, SEO-ready, GitHub Pages.",
  "license": "MIT",
  "repository": "github:SoyHub/SoyHub.github.io",
  "homepage": "https://soyhub.github.io",
  "bugs": "https://github.com/SoyHub/SoyHub.github.io/issues",
  "keywords": [
    "portfolio",
    "cv",
    "resume",
    "template",
    "nextjs",
    "github-pages",
    "static-site",
    "i18n",
    "developer-portfolio"
  ],
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/build-index.ts && tsx scripts/build-pdf.tsx && tsx scripts/build-favicon.tsx",
    "build": "next build",
    "postbuild": "mv out/not-found-page/index.html out/404.html && rm -r out/not-found-page",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "build-index": "tsx scripts/build-index.ts",
    "build-pdf": "tsx scripts/build-pdf.tsx",
    "build-favicon": "tsx scripts/build-favicon.tsx",
    "build-schemas": "tsx scripts/build-schemas.ts",
    "screenshots": "node scripts/screenshots.mjs",
    "evals": "tsx evals/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.4",
    "gray-matter": "^4.0.3",
    "next": "16.3.5",
    "next-intl": "^4.14.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.5.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22"
  }
}
